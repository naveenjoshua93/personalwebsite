---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.number.localeCompare(b.data.number));
const tier1 = services.filter((s) => s.data.tier === 1);
const tier2 = services.filter((s) => s.data.tier === 2);
---

<Base
  title="Services | Techno War Room"
  description="Seven ways we support must-win pursuits: RFP response, proposal decks, security questionnaires, pricing and SOW, startup pitch decks, competitive positioning, and case studies."
>
  <header class="svc-hero">
    <span class="band-top" style="background:var(--red)"></span>
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> ⚡ Services</nav>
      <span class="kicker">The arsenal ⚡ Two tiers, seven weapons</span>
      <h1>Seven ways <span class="hollow-ink">we show up</span></h1>
      <p class="hero-sub">Tier 1 runs inside a live pursuit against a deadline, whether the buyer is an enterprise or an investor. Tier 2 builds your position and proof between pursuits, so the next one starts further ahead.</p>
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="sec-head"><span class="sec-tag">Tier 1 / Pursuit support</span><h2>Inside the <span class="u">live deal</span></h2></div>
      <div class="bento">
        {tier1.map((s) => (
          <div class={`card c-${s.data.color}`}>
            <span class="band"></span>
            <span class="idx">{s.data.number}</span>
            <h3><a href={`/services/${s.id}/`}>{s.data.name}</a></h3>
            <p>{s.data.oneliner}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head"><span class="sec-tag">Tier 2 / Positioning and proof</span><h2>Between <span class="ur">the deals</span></h2></div>
      <div class="bento">
        {tier2.map((s) => (
          <div class="card tier2">
            <span class="tier-chip">Tier 2 ⚡ {s.data.number === '06' ? 'Positioning' : 'Proof'}</span>
            <span class="idx">{s.data.number}</span>
            <h3><a href={`/services/${s.id}/`}>{s.data.name}</a></h3>
            <p>{s.data.oneliner}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="cta" style="padding-top:0">
    <div class="wrap">
      <div class="cta-box">
        <span class="sticker cta-stk">No charge to talk</span>
        <h2>Got a live one?</h2>
        <p>If there is a deal on the table, we can tell you quickly whether we can help and what it would involve. Or write to hello@technowarroom.com.</p>
        <a class="btn" href="mailto:hello@technowarroom.com">Book a call</a>
        <svg class="cta-brick" viewBox="-60 0 240 220" aria-hidden="true"><use href="#brickhero"></use></svg>
      </div>
    </div>
  </section>
</Base>
