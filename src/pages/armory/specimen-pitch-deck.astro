    .m-table th{font-family:var(--mono);font-size:1.25cqw;text-transform:uppercase;letter-spacing:0.06em;color:#4A5261}
    .m-table .hot{background:#2B3FD8;color:#fff;border-color:#2B3FD8}
    .m-person .m-sil{width:6cqw;height:6cqw;border-radius:50%;background:linear-gradient(180deg,#C9CEDA,#8A93A6);margin-bottom:1.2cqw}
    .m-person b{display:block;font-size:1.9cqw}
    .m-person span{display:block;font-size:1.45cqw;color:#4A5261;line-height:1.5;margin-top:0.6cqw}
    .m-usebar{display:flex;height:5cqw;margin-bottom:3cqw;font-family:var(--mono);font-size:1.25cqw;color:#fff;text-transform:uppercase;letter-spacing:0.04em}
    .m-usebar span{background:#2B3FD8;display:flex;align-items:center;padding-left:1.2cqw;white-space:nowrap;overflow:hidden}
    .m-usebar .mid{background:#10141B}
    .m-usebar .end{background:#8A93A6}
