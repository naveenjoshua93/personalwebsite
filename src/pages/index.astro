---
// Placeholder page to prove the build and deploy pipeline end to end.
// The real site starts at Gate 4 (information architecture).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Techno War Room</title>
    <style>
      :root {
        --cream: #f3ede1;
        --ink: #141110;
        --red: #e6401f;
        --mustard: #f2b33d;
        --cyan: #7fd8d4;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: Arial, Helvetica, sans-serif;
        min-height: 100vh;
        display: grid;
        place-items: center;
      }
      main {
        border: 3px solid var(--ink);
        box-shadow: 10px 10px 0 var(--ink);
        background: #fff;
        padding: 48px 56px;
        text-align: center;
        transform: rotate(-1deg);
        max-width: 520px;
        margin: 24px;
      }
      .logo {
        display: inline-block;
        background: var(--ink);
        color: var(--cream);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        padding: 8px 14px;
        font-size: 18px;
      }
      .logo span { color: var(--cyan); }
      h1 {
        margin-top: 28px;
        font-size: 40px;
        line-height: 1.05;
        text-transform: uppercase;
      }
      h1 em { font-style: normal; color: var(--red); }
      p {
        margin-top: 16px;
        font-size: 16px;
        color: #3b3530;
      }
      .stamp {
        display: inline-block;
        margin-top: 24px;
        font-family: Consolas, monospace;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: var(--mustard);
        border: 2px solid var(--ink);
        padding: 6px 10px;
        transform: rotate(2deg);
      }
    </style>
  </head>
  <body>
    <main>
      <span class="logo"><span>Techno</span> War Room</span>
      <h1>The war room is <em>being built.</em></h1>
      <p>Commercial pursuit support for IT services and B2B technology firms.</p>
      <span class="stamp">Pipeline check: deployed from GitHub</span>
    </main>
  </body>
</html>
