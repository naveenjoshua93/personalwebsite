---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Techno War Room" description="This page lost the deal.">
  <div class="lost">
    <div>
      <span class="kicker">Error 404 ⚡ Deal status</span>
      <h1>This page <span class="alarm">lost the deal.</span></h1>
      <svg class="brick-lost" viewBox="-60 0 240 220" aria-label="Brick the mascot, upside down"><use href="#brickhero"></use></svg>
      <p class="hero-sub" style="margin:0 auto">It happens to the best of us. The difference is what you do next.</p>
      <div class="hero-cta" style="justify-content:center">
        <a class="btn btn-big" href="/">Back to the war room</a>
      </div>
    </div>
  </div>
</Base>
