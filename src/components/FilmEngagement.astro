    <g class="fe-fx" data-fx="drop" data-s="21.8"><circle cx="395" cy="398" r="8" fill="#F2B33D" stroke="#141110" stroke-width="3"/><text class="fe-mono-sm" x="395" y="428" fill="#F3EDE1" text-anchor="middle">REVIEW</text></g>
