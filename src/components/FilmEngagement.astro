    <g class="fe-fx" data-fx="pop" data-s="38.6">
      <path d="M380 300 l8 10 l16 -20" fill="none" stroke="#1E7A4E" stroke-width="5"/>
      <path d="M430 300 l8 10 l16 -20" fill="none" stroke="#1E7A4E" stroke-width="5"/>
      <path d="M480 300 l8 10 l16 -20" fill="none" stroke="#1E7A4E" stroke-width="5"/>
      <text class="fe-mono-sm" x="380" y="345" fill="#141110">COMMENTS: RESOLVED</text>
