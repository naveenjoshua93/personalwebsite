<style>
  .film-eng { width: 100%; display: block; }
</style>

<script>
  const LOOP = 48;
  const MS = LOOP * 1000;
  const pct = (s: number) => Math.max(0, Math.min(1, s / LOOP));

  document.querySelectorAll<SVGSVGElement>('.film-eng').forEach((svg) => {
    // scene visibility windows
    svg.querySelectorAll<SVGElement>('.fe-scene').forEach((sc) => {
      const ss = parseFloat(sc.dataset.ss || '0');
      const se = parseFloat(sc.dataset.se || '0');
      sc.animate(
        [
          { opacity: 0, offset: 0 },
          { opacity: 0, offset: pct(ss) },
          { opacity: 1, offset: pct(ss + 0.4) },
          { opacity: 1, offset: pct(se - 0.35) },
          { opacity: 0, offset: pct(se) },
          { opacity: 0, offset: 1 },
        ],
        { duration: MS, iterations: Infinity }
      );
    });

    // loop progress bar
    svg.querySelector<SVGElement>('.fe-progress')?.animate(
      [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
      { duration: MS, iterations: Infinity }
    );

    // per-element effects
    const base = { duration: MS, iterations: Infinity };
    svg.querySelectorAll<SVGElement>('.fe-fx').forEach((el) => {
      const s = parseFloat(el.dataset.s || '0');
      const d = parseFloat(el.dataset.d || '0.5');
      const a = pct(s);
      const b = pct(s + d);
      el.style.transformBox = 'fill-box';
      switch (el.dataset.fx) {
        case 'rise':
          el.animate([
            { opacity: 0, transform: 'translateY(22px)', offset: 0 },
            { opacity: 0, transform: 'translateY(22px)', offset: a },
            { opacity: 1, transform: 'translateY(0)', offset: b },
            { opacity: 1, transform: 'translateY(0)', offset: 1 },
          ], base);
          break;
        case 'slidex':
          el.animate([
            { opacity: 0, transform: 'translateX(-46px)', offset: 0 },
            { opacity: 0, transform: 'translateX(-46px)', offset: a },
            { opacity: 1, transform: 'translateX(0)', offset: b },
            { opacity: 1, transform: 'translateX(0)', offset: 1 },
          ], base);
          break;
        case 'pop':
          el.style.transformOrigin = 'center';
          el.animate([
            { opacity: 0, transform: 'scale(0.4)', offset: 0 },
            { opacity: 0, transform: 'scale(0.4)', offset: a },
            { opacity: 1, transform: 'scale(1.12)', offset: pct(s + d * 0.7) },
            { opacity: 1, transform: 'scale(1)', offset: b },
            { opacity: 1, transform: 'scale(1)', offset: 1 },
          ], base);
          break;
        case 'stamp':
          el.style.transformOrigin = 'center';
          el.animate([
            { opacity: 0, transform: 'scale(2.6) rotate(-14deg)', offset: 0 },
            { opacity: 0, transform: 'scale(2.6) rotate(-14deg)', offset: a },
            { opacity: 1, transform: 'scale(1) rotate(0deg)', offset: b },
            { opacity: 1, transform: 'scale(1) rotate(0deg)', offset: 1 },
          ], base);
          break;
        case 'drop':
          el.animate([
            { opacity: 0, transform: 'translateY(-34px)', offset: 0 },
            { opacity: 0, transform: 'translateY(-34px)', offset: a },
            { opacity: 1, transform: 'translateY(4px)', offset: pct(s + d * 0.8) },
            { opacity: 1, transform: 'translateY(0)', offset: b },
            { opacity: 1, transform: 'translateY(0)', offset: 1 },
          ], base);
          break;
        case 'fly':
          el.animate([
            { opacity: 0, transform: 'translateX(-160px) translateY(10px)', offset: 0 },
            { opacity: 0, transform: 'translateX(-160px) translateY(10px)', offset: a },
            { opacity: 1, transform: 'translateX(0) translateY(0)', offset: pct(s + 0.9) },
            { opacity: 1, transform: 'translateX(120px)', offset: pct(s + 1.7) },
            { opacity: 0, transform: 'translateX(150px)', offset: pct(s + 1.9) },
            { opacity: 0, offset: 1 },
          ], base);
          break;
        case 'cell':
          el.animate([
            { opacity: 0, offset: 0 },
            { opacity: 0, offset: a },
            { opacity: 0.9, offset: pct(s + 0.15) },
            { opacity: 0.9, offset: 1 },
          ], base);
          break;
        case 'fill':
          el.animate([
            { opacity: 1, transform: 'scaleX(0)', offset: 0 },
            { opacity: 1, transform: 'scaleX(0)', offset: a },
            { opacity: 1, transform: 'scaleX(1)', offset: b },
            { opacity: 1, transform: 'scaleX(1)', offset: 1 },
          ], base);
          break;
        case 'jump':
          el.animate([
            { opacity: 0, transform: 'translateY(-140px)', offset: 0 },
            { opacity: 0, transform: 'translateY(-140px)', offset: a },
            { opacity: 1, transform: 'translateY(0)', offset: pct(s + 0.5) },
            { opacity: 1, transform: 'translateY(96px)', offset: pct(s + 0.8) },
            { opacity: 1, transform: 'translateY(70px)', offset: pct(s + 1.0) },
            { opacity: 1, transform: 'translateY(70px)', offset: 1 },
          ], base);
          break;
        case 'confetti':
          el.animate([
            { opacity: 0, transform: 'translateY(0) rotate(0deg)', offset: 0 },
            { opacity: 0, transform: 'translateY(0) rotate(0deg)', offset: a },
            { opacity: 1, transform: 'translateY(-40px) rotate(140deg)', offset: pct(s + 0.5) },
            { opacity: 1, transform: 'translateY(120px) rotate(420deg)', offset: pct(s + 1.8) },
            { opacity: 0, transform: 'translateY(200px) rotate(560deg)', offset: pct(s + 2.3) },
            { opacity: 0, offset: 1 },
          ], base);
          break;
      }
    });
  });
</script>
