        <text class="fe-mono-sm" x="326" y="185" fill="#141110">SMES CAN BE BOOKED</text>
      </g>
      <g class="fe-fx" data-fx="pop" data-s="15.5">
        <rect x="300" y="198" width="16" height="16" fill="none" stroke="#1E7A4E" stroke-width="3"/>
