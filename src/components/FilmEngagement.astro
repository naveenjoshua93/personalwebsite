    <!-- red marks then green ticks -->
    <g class="fe-fx" data-fx="pop" data-s="36.8">
      <path d="M375 250 q30 18 60 0 q10 22 40 12" fill="none" stroke="#E6401F" stroke-width="4"/>
      <circle cx="540" cy="200" r="16" fill="none" stroke="#E6401F" stroke-width="4"/>
