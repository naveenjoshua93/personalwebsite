      <rect x="540" y="120" width="330" height="120" fill="#F3EDE1" stroke="#E6401F" stroke-width="5"/>
      <rect x="540" y="120" width="330" height="30" fill="#E6401F"/>
      <text class="fe-mono-sm" x="554" y="140" fill="#F3EDE1">INBOX ⚡ NEW (1)</text>
      <text class="fe-mono" x="554" y="176" fill="#141110">RFP_FINAL_v3.PDF</text>
      <g class="fe-fx" data-fx="pop" data-s="2.2"><text class="fe-mono-sm" x="554" y="200" fill="#B23A1B">300 QUESTIONS</text></g>
      <g class="fe-fx" data-fx="pop" data-s="3.0"><text class="fe-mono-sm" x="554" y="222" fill="#B23A1B">DUE: 21 DAYS</text></g>
    </g>
    <g class="fe-pulse"><circle cx="540" cy="120" r="26" fill="none" stroke="#E6401F" stroke-width="4"/></g>
    <g class="fe-fx" data-fx="pop" data-s="4.0">
      <text class="fe-disp" x="250" y="200" fill="#F3EDE1" font-size="30">OH NO.</text>
    </g>
  </g>

  <!-- ============ SCENE 2: The call ============ -->
