  <rect x="14" y="14" width="932" height="482" fill="none" stroke="#3B3530" stroke-width="2"/>
  <text class="fe-mono" x="34" y="44" fill="#F3EDE1">TWR ⚡ FILM 01</text>
  <text class="fe-mono" x="34" y="64" fill="#7FD8D4">HOW AN ENGAGEMENT ACTUALLY RUNS</text>

  <!-- loop progress bar -->
  <rect x="34" y="520" width="892" height="6" fill="#3B3530"/>
  <rect class="fe-progress" x="34" y="520" width="892" height="6" fill="#E6401F"/>

  <!-- ============ SCENE 1: Friday 17:04 ============ -->
  <g class="fe-scene" data-ss="0" data-se="6">
    <text class="fe-mono" x="480" y="508" fill="#F2B33D" text-anchor="middle">SCENE 01 ⚡ FRIDAY, 17:04</text>
