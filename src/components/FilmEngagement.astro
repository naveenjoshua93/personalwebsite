    <g id="fe-sme">
      <rect x="14" y="46" width="52" height="46" rx="4" fill="#1E7A4E" stroke="#141110" stroke-width="4"/>
      <rect x="2" y="50" width="16" height="34" rx="7" fill="#1E7A4E" stroke="#141110" stroke-width="4"/>
      <rect x="62" y="50" width="16" height="34" rx="7" fill="#1E7A4E" stroke="#141110" stroke-width="4"/>
      <rect x="20" y="92" width="18" height="30" fill="#141110" stroke="#141110" stroke-width="4"/>
      <rect x="42" y="92" width="18" height="30" fill="#141110" stroke="#141110" stroke-width="4"/>
      <rect x="18" y="2" width="44" height="38" rx="5" fill="#FFD84D" stroke="#141110" stroke-width="4"/>
      <rect x="24" y="-7" width="13" height="10" rx="2" fill="#FFD84D" stroke="#141110" stroke-width="4"/>
      <rect x="44" y="-7" width="13" height="10" rx="2" fill="#FFD84D" stroke="#141110" stroke-width="4"/>
      <circle cx="32" cy="18" r="7" fill="none" stroke="#141110" stroke-width="3"/>
      <circle cx="48" cy="18" r="7" fill="none" stroke="#141110" stroke-width="3"/>
      <line x1="39" y1="18" x2="41" y2="18" stroke="#141110" stroke-width="3"/>
