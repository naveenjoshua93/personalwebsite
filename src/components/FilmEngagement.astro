    <!-- clock -->
    <circle cx="180" cy="180" r="46" fill="none" stroke="#3B3530" stroke-width="4"/>
    <line class="fe-clock" x1="180" y1="180" x2="180" y2="146" stroke="#F3EDE1" stroke-width="4"/>
    <circle cx="180" cy="180" r="5" fill="#F3EDE1"/>
    <!-- coffee cups -->
    <g class="fe-fx" data-fx="pop" data-s="37.2"><g transform="translate(700,380)"><use href="#fe-cup"/></g></g>
