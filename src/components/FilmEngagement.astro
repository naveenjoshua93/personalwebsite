  <style>
    .fe-mono { font: 600 13px 'IBM Plex Mono', monospace; letter-spacing: 0.08em; }
    .fe-mono-sm { font: 600 11px 'IBM Plex Mono', monospace; letter-spacing: 0.06em; }
    .fe-disp { font-family: 'Clash Display','Arial Black',sans-serif; font-weight: 700; }
    .fe-scene { opacity: 0; }
    .fe-fx { opacity: 0; }
    .fe-pulse { animation: fePulse 1.4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    @keyframes fePulse { 0%,100% { opacity: .35; transform: scale(1);} 50% { opacity: .9; transform: scale(1.12);} }
    .fe-clock { animation: feClock 6s linear infinite; transform-box: fill-box; transform-origin: 50% 88%; }
    @keyframes feClock { to { transform: rotate(360deg); } }
    .fe-progress { transform-origin: 34px 524px; }
  </style>

  <!-- stage -->
