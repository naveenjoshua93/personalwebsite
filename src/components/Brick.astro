---
// Brick, the Teclato mascot. An original blocky character, deliberately
// not a LEGO minifigure (square studded head, custom proportions) for trademark safety.
// Rendered once as defs; reuse anywhere with <use href="#brickhero"/> or <use href="#pow"/>.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <g id="brickhero">
      <g stroke="#141110" stroke-width="5" stroke-linecap="round" opacity=".7">
        <line x1="-38" y1="150" x2="8" y2="138"/><line x1="-46" y1="176" x2="6" y2="166"/><line x1="-30" y1="202" x2="12" y2="192"/>
      </g>
      <path d="M60 88 Q10 130 24 196 Q60 176 76 188 L84 100 Z" fill="#E6401F" stroke="#141110" stroke-width="5"/>
      <rect x="98" y="150" width="30" height="52" fill="#2B3FD8" stroke="#141110" stroke-width="5"/>
      <rect x="66" y="158" width="30" height="52" fill="#2B3FD8" stroke="#141110" stroke-width="5" transform="rotate(18 81 184)"/>
      <rect x="58" y="84" width="76" height="72" rx="4" fill="#F2B33D" stroke="#141110" stroke-width="5"/>
      <text x="96" y="132" font-family="Arial Black, Arial" font-weight="900" font-size="30" text-anchor="middle" fill="#141110">TL</text>
      <rect x="118" y="92" width="52" height="24" rx="10" fill="#F2B33D" stroke="#141110" stroke-width="5" transform="rotate(28 144 104)"/>
      <rect x="24" y="52" width="58" height="24" rx="10" fill="#F2B33D" stroke="#141110" stroke-width="5" transform="rotate(-38 53 64)"/>
      <circle cx="26" cy="34" r="13" fill="#FFD84D" stroke="#141110" stroke-width="5"/>
      <rect x="66" y="22" width="60" height="52" rx="6" fill="#FFD84D" stroke="#141110" stroke-width="5"/>
      <rect x="72" y="10" width="18" height="14" rx="3" fill="#FFD84D" stroke="#141110" stroke-width="5"/>
      <rect x="102" y="10" width="18" height="14" rx="3" fill="#FFD84D" stroke="#141110" stroke-width="5"/>
      <rect x="66" y="34" width="60" height="14" fill="#2B3FD8" stroke="#141110" stroke-width="4"/>
      <circle cx="86" cy="41" r="4" fill="#fff"/><circle cx="108" cy="41" r="4" fill="#fff"/>
      <path d="M84 60 Q96 70 110 58" fill="none" stroke="#141110" stroke-width="4" stroke-linecap="round"/>
    </g>
    <g id="pow">
      <path d="M75 4 L90 34 L122 22 L104 50 L138 60 L102 70 L116 100 L84 84 L72 116 L62 82 L28 96 L48 66 L12 56 L50 46 L36 14 L68 32 Z"
            fill="#F2B33D" stroke="#141110" stroke-width="5"/>
      <text x="75" y="70" font-family="Arial Black, Arial" font-weight="900" font-size="26" text-anchor="middle" fill="#141110">POW!</text>
    </g>
  </defs>
</svg>
